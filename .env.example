# ==============================================================================
# Temple Chatbot Platform - Production Environment Configuration Template
# ==============================================================================

# Project Information
PROJECT_NAME="Temple Chatbot Platform API"
VERSION="0.1.0"
DESCRIPTION="Backend API for Temple Chatbot Platform"
API_V1_STR="/api/v1"

# Server Environment & Execution
# Set ENVIRONMENT="production" in production deployments (triggers validation guards)
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Logging Architecture
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
# LOG_FORMAT: "text" (human-readable) or "json" (structured single-line JSON for Datadog/CloudWatch)
LOG_FORMAT="text"

# Production Security Headers
SECURE_HEADERS_ENABLED=true

# CORS Configuration
# Set CORS_ALLOW_ALL_ORIGINS=true to allow embedding chat widgets across all temple websites
CORS_ALLOW_ALL_ORIGINS=true
# Optional regex to restrict origins in production: e.g. "^https://.*\\.temple\\.org$"
CORS_ORIGIN_REGEX=""
# Comma-separated or JSON list of explicitly allowed origins when CORS_ALLOW_ALL_ORIGINS=false
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# Rate Limiting Architecture
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10

# MongoDB Atlas Database Configuration
# In production: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# In development: mongodb://localhost:27017
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="temple_chatbot_db"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=15000
MONGODB_MAX_IDLE_TIME_MS=60000

# Embedding & Vector Search Configuration
# Open-source local embedding model (runs via FastEmbed ONNX runtime, CPU-optimized)
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
VECTOR_SEARCH_INDEX_NAME="vector_index"
DEFAULT_TOP_K=5
NUM_CANDIDATES_MULTIPLIER=10

# Document Ingestion & Operational Limits
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
MAX_UPLOAD_FILE_SIZE_BYTES=26214400  # 25 MB max document file upload size

# Website Crawler Configuration (Playwright)
CRAWLER_MAX_PAGES=15
CRAWLER_MAX_ALLOWED_PAGES=50        # Hard ceiling for single crawl job
CRAWLER_MAX_DEPTH=3
CRAWLER_PAGE_TIMEOUT_MS=30000
CRAWLER_WAIT_AFTER_LOAD_MS=1000
CRAWLER_USER_AGENT="TempleAssistCrawler/1.0"
CRAWLER_MAX_CONCURRENCY=2           # Max concurrent browser processes
CRAWLER_TOTAL_TIMEOUT_SECONDS=300   # 5 minutes max total duration per crawl job

# LLM & Grounded RAG Configuration
# Providers supported: "gemini", "openai", "mock"
LLM_PROVIDER="gemini"
# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
# Optional OpenAI configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""
# RAG Retrieval & Prompt Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=30.0
RAG_DEFAULT_SIMILARITY_THRESHOLD=0.4
RAG_DEFAULT_TOP_K=5
RAG_MAX_CONTEXT_CHUNKS=8

# Conversation & Session History Retention
MAX_CONVERSATION_HISTORY_TURNS=5
CONVERSATION_RETENTION_DAYS=30      # Auto-purged via TTL index in MongoDB

# JWT & Admin Authentication Configuration
# MUST be a strong, unpredictable 32+ character secret in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="generate-a-strong-secret-key-at-least-32-chars-long"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours validity
