# ==============================================================================
# Temple Chatbot Platform - Backend Environment Configuration
# ==============================================================================

# Project Information
PROJECT_NAME="Temple Chatbot Platform API"
VERSION="0.1.0"
DESCRIPTION="Backend API for Temple Chatbot Platform"
API_V1_STR="/api/v1"

# Server Configuration
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Logging
# Valid options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# CORS Configuration (comma-separated list of allowed origins or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# MongoDB Atlas Configuration
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="temple_chatbot_db"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# Future Extension Placeholders (Do not uncomment until respective phases)
# VECTOR_STORE_TYPE=qdrant
# EMBEDDING_MODEL=text-embedding-3-small
