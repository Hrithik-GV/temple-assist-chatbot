# ==============================================================================
# Temple Chatbot Platform - Backend Environment Configuration
# ==============================================================================

# Project Information
PROJECT_NAME="Temple Chatbot Platform API"
VERSION="0.1.0"
DESCRIPTION="Backend API for Temple Chatbot Platform"
API_V1_STR="/api/v1"

# Server Configuration
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Logging
# Valid options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# CORS Configuration (comma-separated list of allowed origins or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# MongoDB Atlas Configuration
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="temple_chatbot_db"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# Embedding & Vector Search Configuration
# Open-source local embedding model (runs via FastEmbed ONNX runtime)
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
VECTOR_SEARCH_INDEX_NAME="vector_index"
DEFAULT_TOP_K=5

# Document Ingestion Configuration
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# Website Crawler Configuration (Playwright)
CRAWLER_MAX_PAGES=15
CRAWLER_MAX_DEPTH=3
CRAWLER_PAGE_TIMEOUT_MS=30000
CRAWLER_WAIT_AFTER_LOAD_MS=1000
CRAWLER_USER_AGENT="TempleAssistCrawler/1.0"

# LLM & RAG Configuration
# Providers supported: "gemini", "openai", "mock"
LLM_PROVIDER="gemini"
# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
# Optional OpenAI configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""
# RAG Retrieval & Prompt Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=30.0
RAG_DEFAULT_SIMILARITY_THRESHOLD=0.4
RAG_DEFAULT_TOP_K=5
RAG_MAX_CONTEXT_CHUNKS=8
